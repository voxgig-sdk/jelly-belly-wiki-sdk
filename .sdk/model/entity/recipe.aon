# Entity: recipe

main: kit: entity: recipe: {

  alias: field: {}

  fields: [
    {
      name: "cookTime"
      req: false
      short: "Cooking time"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Description of the recipe"
      type: "`$STRING`"
    }
    {
      name: "directions"
      req: false
      short: "Step-by-step directions"
      type: "`$ARRAY`"
    }
    {
      name: "imageUrl"
      req: false
      short: "URL to the recipe image"
      type: "`$STRING`"
    }
    {
      name: "ingredients"
      req: false
      short: "List of ingredients"
      type: "`$ARRAY`"
    }
    {
      name: "makingAmount"
      req: false
      short: "Amount the recipe makes"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the recipe"
      type: "`$STRING`"
    }
    {
      name: "prepTime"
      req: false
      short: "Preparation time"
      type: "`$STRING`"
    }
    {
      name: "recipeId"
      req: false
      short: "Unique identifier for the recipe"
      type: "`$STRING`"
    }
    {
      name: "totalTime"
      req: false
      short: "Total time required"
      type: "`$STRING`"
    }
  ]

  name: "recipe"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/recipes"
          parts: [
            "recipes"
          ]
          select: {
            exist: [
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
  }



}
