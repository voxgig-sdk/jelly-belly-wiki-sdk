# Entity: bean

main: kit: entity: bean: {

  alias: field: {}

  fields: [
    {
      name: "backgroundColor"
      req: false
      type: "`$STRING`"
    }
    {
      name: "beanId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "colorGroup"
      req: false
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "flavorName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "glutenFree"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "groupName"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "imageUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ingredients"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "kosher"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "sugarFree"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "bean"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/beans"
          parts: [
            "beans"
          ]
          select: {
            exist: [
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "bean_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/beans/{beanId}"
          parts: [
            "beans"
            "{id}"
          ]
          rename: {
            param: {
              beanId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
