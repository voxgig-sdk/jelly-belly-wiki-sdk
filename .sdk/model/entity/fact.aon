# Entity: fact

main: kit: entity: fact: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Full text of the fact"
      type: "`$STRING`"
    }
    {
      name: "factId"
      req: false
      short: "Unique identifier for the fact"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the fact"
      type: "`$STRING`"
    }
  ]

  name: "fact"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/facts"
          parts: [
            "facts"
          ]
          select: {
            exist: [
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
  }



}
