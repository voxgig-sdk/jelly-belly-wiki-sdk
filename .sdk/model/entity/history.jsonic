# Entity: history

main: kit: entity: history: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "history_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "year"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "history"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/history"
          parts: [
            "history"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
