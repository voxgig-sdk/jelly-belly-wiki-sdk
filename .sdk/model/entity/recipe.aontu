# Entity: recipe

main: kit: entity: recipe: {

  alias: field: {}

  fields: [
    {
      name: "cookTime"
      req: false
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "directions"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "imageUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ingredients"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "makingAmount"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "prepTime"
      req: false
      type: "`$STRING`"
    }
    {
      name: "recipeId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "totalTime"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "recipe"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/recipes"
          parts: [
            "recipes"
          ]
          select: {
            exist: [
              "limit"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
  }



}
