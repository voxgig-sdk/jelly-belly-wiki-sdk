  "components": {
    "schemas": {
      "Bean": {
        "type": "object",
        "properties": {
          "beanId": {
            "type": "string",
            "description": "Unique identifier for the bean"
          },
          "groupName": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group or category names the bean belongs to"
          },
          "flavorName": {
            "type": "string",
            "description": "Name of the flavor"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the bean flavor"
          },
          "colorGroup": {
            "type": "string",
            "description": "Color category of the bean"
          },
          "backgroundColor": {
            "type": "string",
            "description": "Hex color code for the bean's background color"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to the bean image"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of ingredients"
          },
          "glutenFree": {
            "type": "boolean",
            "description": "Indicates if the bean is gluten-free"
          },
          "sugarFree": {
            "type": "boolean",
            "description": "Indicates if the bean is sugar-free"
          },
          "kosher": {
            "type": "boolean",
            "description": "Indicates if the bean is kosher certified"
          }
        }
      },
      "Fact": {
        "type": "object",
        "properties": {
          "factId": {
            "type": "string",
            "description": "Unique identifier for the fact"
          },
          "title": {
            "type": "string",
            "description": "Title of the fact"
          },
          "description": {
            "type": "string",
            "description": "Full text of the fact"
          }
        }
      },
      "Recipe": {
        "type": "object",
        "properties": {
          "recipeId": {
            "type": "string",
            "description": "Unique identifier for the recipe"
          },
          "name": {
            "type": "string",
            "description": "Name of the recipe"
          },
          "description": {
            "type": "string",
            "description": "Description of the recipe"
          },
          "prepTime": {
            "type": "string",
            "description": "Preparation time"
          },
          "cookTime": {
            "type": "string",
            "description": "Cooking time"
          },
          "totalTime": {
            "type": "string",
            "description": "Total time required"
          },
          "makingAmount": {
            "type": "string",
            "description": "Amount the recipe makes"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to the recipe image"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of ingredients"
          },
          "directions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Step-by-step directions"
          }
        }
      },
      "Combination": {
        "type": "object",
        "properties": {
          "combinationId": {
            "type": "string",
            "description": "Unique identifier for the combination"
          },
          "name": {
            "type": "string",
            "description": "Name of the flavor combination"
          },
          "tag": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags associated with the combination"
          },
          "beans": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of bean flavors in the combination"
          }
        }
      },
      "HistoryEntry": {
        "type": "object",
        "properties": {
          "historyId": {
            "type": "string",
            "description": "Unique identifier for the history entry"
          },
          "year": {
            "type": "integer",
            "description": "Year of the historical event"
          },
          "description": {
            "type": "string",
            "description": "Description of the historical event"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "message": {
            "type": "string",
            "description": "Detailed error description"
          },
          "statusCode": {
            "type": "integer",
            "description": "HTTP status code"
          }
        }
      }
    }
